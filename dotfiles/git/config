[user]
	name = Ivan E. Hernandez T.
	email = ivan@ivanhx.com
	useConfigOnly = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgSign = true
	verbose = true
[branch]
	sort = -committerdate
[tag]
	gpgSign = true
	sort = version:refname
[column]
	ui = auto
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
	followTags = true
[fetch]
	prune = true
[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true
[rerere]
	enabled = true
[merge]
	conflictStyle = zdiff3
[diff]
	algorithm = histogram
	colorMoved = plain
[core]
	editor = code --wait
	pager = delta
[help]
	autocorrect = prompt
[interactive]
	diffFilter = delta --color-only
[delta]
	syntax-theme = ansi
	navigate = true
[include]
	path = ~/.config/git/config.local
