HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY EXTENDED_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_VERIFY

autoload -Uz compinit && compinit

export EDITOR="code --wait"
export FZF_DEFAULT_OPTS="--color=16"

eval "$(mise activate zsh)"
source <(fzf --zsh)

# Follow the macOS appearance. The prompt, bat and delta use the terminal's colours.
# Only the text on the prompt's segments changes: black in dark mode, white in light mode.
_follow_appearance() {
  if [[ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" == "Dark" ]]; then
    export STARSHIP_CONFIG="$HOME/.config/starship.toml"
  else
    export STARSHIP_CONFIG="$HOME/.config/starship-light.toml"
  fi
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd _follow_appearance

eval "$(starship init zsh)"

source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
